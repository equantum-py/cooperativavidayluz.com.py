}

function Footer() {
  return <footer className="bg-dark px-6 pb-10 text-center text-sm text-white/45">© 2026   · Paraguay · Confianza, innovación y comunidad.</footer>;
}

export default function LandingPage() {
  const { scrollYProgress } = useScroll();
  const scaleX = useSpring(scrollYProgress, { stiffness: 120, damping: 30 });
  return (
    <main>
      <motion.div style={{ scaleX }} className="fixed left-0 top-0 z-[60] h-1 w-full origin-left bg-gradient-to-r from-primary to-accent" />
      <Navbar />
      <Hero />
      <Stats />
      <Services />
      <Timeline />
      <Benefits />
      <Portal />
      <Testimonials />
      <News />
      <FinalCta />
      <Footer />
    </main>
  );
}
